# VeriKVM credentials — the username/password that unlocks YOUR target machine.
#
# HOW TO USE: copy this file to ".env" and fill it in. The real ".env" is
# gitignored and must NEVER be committed.
#
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows)
#
# MORE SECURE: leave the password out of any file and store it in your OS
# keyring instead (see SECURITY.md), or leave it blank here to be prompted
# at runtime. A file on disk — even gitignored — is still a file; a synced
# folder (OneDrive, Dropbox, iCloud) uploads it to the cloud in cleartext.

VERIKVM_USERNAME=your-target-username

# Leave blank to be prompted at runtime, or to use the OS keyring.
VERIKVM_PASSWORD=
